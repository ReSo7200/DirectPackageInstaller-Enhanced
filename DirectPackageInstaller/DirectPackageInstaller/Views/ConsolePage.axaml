<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DirectPackageInstaller.ViewModels"
             x:Class="DirectPackageInstaller.Views.ConsolePage"
             x:DataType="vm:ConsoleViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Classes="pagehead">
            <StackPanel Spacing="2">
                <TextBlock Classes="h1" Text="On PS4"/>
                <TextBlock Classes="muted" FontSize="13" Text="{Binding Summary}" TextWrapping="Wrap"/>
                <TextBlock FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Text}"
                           Text="{Binding FreeSpace}" IsVisible="{Binding HasFreeSpace}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock FontSize="12.5" Foreground="{StaticResource Signal}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{Binding CapturesStatus}" IsVisible="{Binding HasCapturesStatus}"/>
            </StackPanel>
            <WrapPanel Classes="headbutton" VerticalAlignment="Center" ItemSpacing="8" LineSpacing="8">
                <Button Name="BtnCaptures" IsEnabled="{Binding CanCopyCaptures}" ToolTip.ShowOnDisabled="True"
                        ToolTip.Tip="{Binding CapturesTip}">Copy screenshots &amp; videos</Button>
                <Button Name="BtnRefresh" Classes="primary" MinWidth="110"
                        IsEnabled="{Binding CanRefresh}" Content="{Binding RefreshText}"
                        ToolTip.Tip="{Binding RefreshTip}" ToolTip.ShowOnDisabled="True"/>
            </WrapPanel>
        </Grid>

        <!-- storage boxes: free space per drive (experimental payload) -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Storage}" IsVisible="{Binding HasStorage}" Classes="storage">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" ColumnSpacing="10"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StorageBox">
                    <Border Classes="card" Padding="14,12">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="eyebrow" Text="{Binding Name}" Foreground="{Binding Accent}"
                                       TextTrimming="CharacterEllipsis"/>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FreeText}" FontFamily="{StaticResource Display}" FontWeight="SemiBold"
                                           FontSize="24" Margin="0,0,6,0" VerticalAlignment="Bottom"/>
                                <TextBlock Classes="muted" FontSize="12" Text="{Binding TotalText}" VerticalAlignment="Bottom"
                                           Margin="0,0,0,4"/>
                            </WrapPanel>
                            <Panel Height="6" Margin="0,6,0,4">
                                <Border Background="{StaticResource Line}" CornerRadius="3"/>
                                <Border Background="{Binding BarBrush}" CornerRadius="3" RenderTransformOrigin="0%,50%">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Used}" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Panel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="mono" FontSize="11.5" Text="{Binding UsedText}"/>
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" Text="{Binding TitlesText}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Grid.Row="2" Name="Filters" Orientation="Horizontal" IsVisible="{Binding Loaded}" Classes="pagebody chips">
            <TextBox Name="SearchBox" Width="290" Text="{Binding Search}" Watermark="Search title or CUSA ID" Margin="0,0,8,0"/>
            <RadioButton Classes="chip" GroupName="consoleKind" Name="FilterAll" IsChecked="True" VerticalAlignment="Center">All</RadioButton>
            <RadioButton Classes="chip" GroupName="consoleKind" Name="FilterGames" VerticalAlignment="Center">Games</RadioButton>
            <RadioButton Classes="chip" GroupName="consoleKind" Name="FilterApps" VerticalAlignment="Center">Apps</RadioButton>
            <RadioButton Classes="chip" GroupName="consoleKind" Name="FilterExt" VerticalAlignment="Center">Extended storage</RadioButton>
        </WrapPanel>

        <Panel Grid.Row="3">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}" Classes="grid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConsoleTitleItem">
                            <StackPanel Classes="tile" ToolTip.Tip="{Binding Tooltip}" Background="Transparent">
                                <StackPanel.ContextMenu>
                                    <ContextMenu Opening="TileMenuOpening">
                                        <MenuItem Header="Show in Library" Tag="{Binding}" Click="MenuShowInLibraryClick" Classes="library"/>
                                        <MenuItem Header="Copy title ID" Tag="{Binding}" Click="MenuCopyIdClick"/>
                                        <MenuItem Header="Back up saves" Tag="{Binding}" Click="MenuBackupSavesClick" Classes="ftp"/>
                                        <Separator/>
                                        <MenuItem Header="Move to extended storage…" Tag="{Binding}" Click="MenuMoveClick"
                                                  IsVisible="{Binding OnSystem}" Classes="move"/>
                                        <MenuItem Header="Move to system storage…" Tag="{Binding}" Click="MenuMoveClick"
                                                  IsVisible="{Binding OnExtended}" Classes="move"/>
                                        <Separator/>
                                        <MenuItem Header="Uninstall update…" Tag="{Binding}" Click="MenuUninstallUpdateClick"
                                                  IsVisible="{Binding CanUninstallUpdate}" Classes="rpi"/>
                                        <MenuItem Header="Uninstall…" Tag="{Binding}" Click="MenuUninstallClick" Classes="rpi"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Panel Classes="cover">
                                    <Border CornerRadius="7" ClipToBounds="True" Background="{StaticResource Raised}">
                                        <Panel>
                                            <TextBlock Classes="mono" FontSize="13" Text="{Binding TitleId}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasCover}"/>
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                        </Panel>
                                    </Border>
                                    <Border Classes="kind" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                        <TextBlock Text="{Binding KindText}" Foreground="{Binding KindBrush}"/>
                                    </Border>
                                    <Border Classes="kind" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                            IsVisible="{Binding ShowStorage}">
                                        <TextBlock Text="{Binding StorageText}" Foreground="{Binding StorageBrush}"/>
                                    </Border>
                                </Panel>
                                <Border Height="4" Margin="2,7,2,0" CornerRadius="2" Background="{Binding RailBrush}"/>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontWeight="SemiBold"
                                           FontSize="16.5" LineHeight="19" MaxLines="2" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" Margin="2,8,2,2" Height="38"/>
                                <TextBlock Classes="mono" Margin="2,0">
                                    <Run Text="{Binding TitleId}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding VersionText}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding DetailText}" Classes="muted" FontSize="11.5" Margin="2,3,2,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding ShowIntro}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="10" MaxWidth="440" Margin="20,0">
                <TextBlock Classes="h2" Text="See everything installed on the console" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Games, apps, installed updates and DLC on system and extended storage, read from the console with GoldHEN's FTP server. Works without a library."/>
                <Button Name="BtnRefreshIntro" Classes="primary" HorizontalAlignment="Center" Margin="0,6,0,0"
                        IsEnabled="{Binding CanRefresh}" ToolTip.Tip="{Binding RefreshTip}" ToolTip.ShowOnDisabled="True">Read the console</Button>
            </StackPanel>
        </Panel>
    </Grid>

    <UserControl.Styles>
        <!-- wide layout: kept in styles, not attributes, so the narrow styles below can override it -->
        <Style Selector="WrapPanel.chips > :is(Control)">
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style Selector="Grid.pagehead">
            <Setter Property="Margin" Value="28,22,28,14"/>
        </Style>
        <Style Selector=":is(Control).headbutton">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="WrapPanel.pagebody">
            <Setter Property="Margin" Value="28,0,28,12"/>
        </Style>
        <Style Selector="ItemsControl.grid">
            <Setter Property="Margin" Value="28,4,14,20"/>
        </Style>
        <Style Selector="StackPanel.tile">
            <Setter Property="Width" Value="176"/>
            <Setter Property="Margin" Value="0,0,16,20"/>
        </Style>
        <Style Selector="Panel.cover">
            <Setter Property="Width" Value="176"/>
            <Setter Property="Height" Value="176"/>
        </Style>

        <!-- phones and narrow windows (the search box width is set in code) -->
        <Style Selector="ItemsControl.storage">
            <Setter Property="Margin" Value="28,0,28,14"/>
            <Setter Property="MaxWidth" Value="720"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector=":is(UserControl).narrow ItemsControl.storage">
            <Setter Property="Margin" Value="14,0,14,10"/>
            <Setter Property="MaxWidth" Value="100000"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector=":is(UserControl).narrow Grid.pagehead">
            <Setter Property="Margin" Value="14,14,14,8"/>
        </Style>
        <Style Selector=":is(UserControl).narrow :is(Control).headbutton">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector=":is(UserControl).narrow WrapPanel.pagebody">
            <Setter Property="Margin" Value="14,0,14,8"/>
        </Style>
        <!-- two tiles per row on a ~360 dp phone -->
        <Style Selector=":is(UserControl).narrow ItemsControl.grid">
            <Setter Property="Margin" Value="14,4,2,16"/>
        </Style>
        <Style Selector=":is(UserControl).narrow StackPanel.tile">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="0,0,12,16"/>
        </Style>
        <Style Selector=":is(UserControl).narrow Panel.cover">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="160"/>
        </Style>
    </UserControl.Styles>
</UserControl>
