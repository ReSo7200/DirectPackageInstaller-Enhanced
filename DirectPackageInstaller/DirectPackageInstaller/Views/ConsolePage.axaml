<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DirectPackageInstaller.ViewModels"
             x:Class="DirectPackageInstaller.Views.ConsolePage"
             x:DataType="vm:ConsoleViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="28,22,28,14" Classes="pagehead">
            <StackPanel Spacing="2">
                <TextBlock Classes="h1" Text="On PS4"/>
                <TextBlock Classes="muted" FontSize="13" Text="{Binding Summary}" TextWrapping="Wrap"/>
                <TextBlock FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Text}"
                           Text="{Binding FreeSpace}" IsVisible="{Binding HasFreeSpace}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Name="BtnRefresh" Classes="primary headbutton" VerticalAlignment="Center" MinWidth="110"
                    IsEnabled="{Binding !IsLoading}" Content="{Binding RefreshText}"
                    ToolTip.Tip="Read what's installed on the console (GoldHEN FTP)"/>
        </Grid>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="28,0,28,12" IsVisible="{Binding Loaded}" Classes="pagebody chips">
            <TextBox Width="290" Text="{Binding Search}" Watermark="Search title or CUSA ID" Margin="0,0,8,0" Classes="search"/>
            <RadioButton Classes="chip" GroupName="consoleKind" Name="FilterAll" IsChecked="True" VerticalAlignment="Center">All</RadioButton>
            <RadioButton Classes="chip" GroupName="consoleKind" Name="FilterGames" VerticalAlignment="Center">Games</RadioButton>
            <RadioButton Classes="chip" GroupName="consoleKind" Name="FilterApps" VerticalAlignment="Center">Apps</RadioButton>
            <RadioButton Classes="chip" GroupName="consoleKind" Name="FilterExt" VerticalAlignment="Center">Extended storage</RadioButton>
        </WrapPanel>

        <Panel Grid.Row="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}" Margin="28,4,14,20" Classes="grid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConsoleTitleItem">
                            <StackPanel Width="176" Margin="0,0,16,20" ToolTip.Tip="{Binding Tooltip}" Background="Transparent">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Show in Library" Tag="{Binding}" Click="MenuShowInLibraryClick"/>
                                        <MenuItem Header="Copy title ID" Tag="{Binding}" Click="MenuCopyIdClick"/>
                                        <Separator/>
                                        <MenuItem Header="Uninstall update…" Tag="{Binding}" Click="MenuUninstallUpdateClick"
                                                  IsVisible="{Binding CanUninstallUpdate}"/>
                                        <MenuItem Header="Uninstall…" Tag="{Binding}" Click="MenuUninstallClick"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Panel Width="176" Height="176">
                                    <Border CornerRadius="7" ClipToBounds="True" Background="{StaticResource Raised}">
                                        <Panel>
                                            <TextBlock Classes="mono" FontSize="13" Text="{Binding TitleId}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasCover}"/>
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                        </Panel>
                                    </Border>
                                    <Border Classes="kind" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                        <TextBlock Text="{Binding KindText}" Foreground="{Binding KindBrush}"/>
                                    </Border>
                                    <Border Classes="kind" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                            IsVisible="{Binding ShowStorage}">
                                        <TextBlock Text="{Binding StorageText}" Foreground="{Binding StorageBrush}"/>
                                    </Border>
                                </Panel>
                                <Border Height="4" Margin="2,7,2,0" CornerRadius="2" Background="{Binding RailBrush}"/>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontWeight="SemiBold"
                                           FontSize="16.5" LineHeight="19" MaxLines="2" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" Margin="2,8,2,2" Height="38"/>
                                <TextBlock Classes="mono" Margin="2,0">
                                    <Run Text="{Binding TitleId}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding VersionText}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding DetailText}" Classes="muted" FontSize="11.5" Margin="2,3,2,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding ShowIntro}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="10" MaxWidth="440">
                <TextBlock Classes="h2" Text="See everything installed on the console" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Games, apps, installed updates and DLC on system and extended storage, read from the console with GoldHEN's FTP server. Works without a library."/>
                <Button Name="BtnRefreshIntro" Classes="primary" HorizontalAlignment="Center" Margin="0,6,0,0">Read the console</Button>
            </StackPanel>
        </Panel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="WrapPanel.chips > :is(Control)">
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style Selector=":is(UserControl).narrow Grid.pagehead">
            <Setter Property="Margin" Value="14,14,14,8"/>
        </Style>
        <Style Selector=":is(UserControl).narrow Button.headbutton">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector=":is(UserControl).narrow WrapPanel.pagebody">
            <Setter Property="Margin" Value="14,0,14,8"/>
        </Style>
        <Style Selector=":is(UserControl).narrow TextBox.search">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="MinWidth" Value="260"/>
        </Style>
        <Style Selector=":is(UserControl).narrow ItemsControl.grid">
            <Setter Property="Margin" Value="14,4,0,16"/>
        </Style>
    </UserControl.Styles>
</UserControl>
