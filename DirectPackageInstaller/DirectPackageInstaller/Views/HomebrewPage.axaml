<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="using:DirectPackageInstaller.Services"
             x:Class="DirectPackageInstaller.Views.HomebrewPage">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Classes="pagehead">
            <StackPanel Spacing="2">
                <TextBlock Classes="h1" Text="Homebrew"/>
                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                           Text="Free PS4 apps, downloaded from their authors' GitHub releases. Download &amp; send puts the package in the Queue."/>
            </StackPanel>
            <Button Name="BtnRefresh" VerticalAlignment="Center" Classes="headbutton"
                    ToolTip.Tip="Check each project for a newer release">Check for updates</Button>
        </Grid>

        <!-- the user's own projects -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Classes="addrow">
            <TextBox Name="RepoBox" Watermark="Add a GitHub project: owner/name or its URL"/>
            <Button Grid.Column="1" Name="BtnAdd" IsEnabled="False"
                    ToolTip.Tip="Its latest release must have a .pkg file">Add project</Button>
        </Grid>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="AppList" Classes="list">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:HomebrewApp">
                        <Border Classes="card" Padding="14,12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" Classes="entry">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="17"/>
                                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12.5" TextWrapping="Wrap"/>
                                    <TextBlock Classes="mono" Text="{Binding Detail}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Status}" FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{StaticResource Signal}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Classes="actions">
                                    <Button Classes="primary" Content="Download &amp; send" Tag="{Binding}" Click="GetClick"
                                            IsEnabled="{Binding CanGet}" ToolTip.ShowOnDisabled="True"
                                            ToolTip.Tip="Downloads the package from the project's release and adds it to the Queue"/>
                                    <Button Classes="ghost" Content="Project page" Tag="{Binding}" Click="PageClick"/>
                                    <Button Classes="ghost danger" Content="Remove" Tag="{Binding}" Click="RemoveClick"
                                            IsVisible="{Binding Custom}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

    <UserControl.Styles>
        <!-- wide layout: kept in styles so the narrow styles below can override it -->
        <Style Selector="Grid.pagehead">
            <Setter Property="Margin" Value="28,22,28,14"/>
        </Style>
        <Style Selector="Button.headbutton">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid.addrow">
            <Setter Property="Margin" Value="28,0,28,14"/>
            <Setter Property="MaxWidth" Value="720"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector=":is(Control).list">
            <Setter Property="Margin" Value="28,0,28,24"/>
        </Style>
        <Style Selector="Grid.entry > StackPanel.actions">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>

        <!-- phones and narrow windows -->
        <Style Selector=":is(UserControl).narrow Grid.pagehead">
            <Setter Property="Margin" Value="14,14,14,8"/>
        </Style>
        <Style Selector=":is(UserControl).narrow Button.headbutton">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector=":is(UserControl).narrow Grid.addrow">
            <Setter Property="Margin" Value="10,0,10,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector=":is(UserControl).narrow :is(Control).list">
            <Setter Property="Margin" Value="10,0,10,16"/>
        </Style>
        <Style Selector=":is(UserControl).narrow Grid.entry > StackPanel.actions">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </UserControl.Styles>
</UserControl>
